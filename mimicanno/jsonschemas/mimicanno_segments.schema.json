{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mimicanno/mimicanno_segments.schema.json",
  "title": "MimicAnno segments sidecar parquet column-set",
  "description": "Documentation-only schema for meta/mimicanno_segments.parquet (spec §3.1). Not validated at runtime against the parquet file itself; pyarrow handles type checks. The 'required_columns' object lists each column with its Arrow logical type and nullability.",
  "type": "object",
  "required": ["schema_version", "required_columns"],
  "schema_version": "1",
  "required_columns": {
    "episode_index": {"type": "int64", "nullable": false},
    "segment_index": {"type": "int32", "nullable": false},
    "segment_id": {"type": "string", "nullable": false},
    "phase": {"type": "string", "nullable": false},
    "verb": {"type": "string", "nullable": true},
    "object": {"type": "string", "nullable": true},
    "target": {"type": "string", "nullable": true},
    "failure_flags": {"type": "list<string>", "nullable": false},
    "start_frame": {"type": "int64", "nullable": false},
    "end_frame": {"type": "int64", "nullable": false},
    "start_time": {"type": "float64", "nullable": false},
    "end_time": {"type": "float64", "nullable": false},
    "label_source": {"type": "string", "nullable": false},
    "object_state_unavailable": {"type": "bool", "nullable": false},
    "object_track_ids": {"type": "list<string>", "nullable": false},
    "label_version": {"type": "string", "nullable": false},
    "boundary_confidence": {"type": "float32", "nullable": false},
    "vlm_confidence": {"type": "float32", "nullable": true},
    "overall_confidence": {"type": "float32", "nullable": false},
    "evidence": {"type": "string", "nullable": true},
    "reviewed": {"type": "bool", "nullable": false},
    "reviewer_id": {"type": "string", "nullable": true},
    "smoothing_ops": {"type": "list<string>", "nullable": false},
    "boundary_source_start": {"type": "list<string>", "nullable": false},
    "boundary_source_end": {"type": "list<string>", "nullable": false},
    "run_hash": {"type": "string", "nullable": false},
    "config_hash": {"type": "string", "nullable": false},
    "input_hash": {"type": "string", "nullable": false},
    "pipeline_phase": {"type": "int8", "nullable": false},
    "mimicanno_version": {"type": "string", "nullable": false},
    "generated_at": {"type": "string", "nullable": false}
  }
}
